---
import ScrapSheet from "../components/ScrapSheet.jsx";
import TrackingScript from "../components/TrackingScript.astro";

const base = import.meta.env.BASE_URL ?? "/";
const basePath = base.endsWith("/") ? base : `${base}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${basePath}favicon-48.png`} type="image/png" sizes="48x48" />
    <link rel="shortcut icon" href={`${basePath}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${basePath}apple-touch-icon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Travel Stories</title>
    <TrackingScript />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Jost:wght@300;400;500;600&family=Lora:ital,wght@0,400;0,500;1,400&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style="margin:0">
    <ScrapSheet client:load backHref={basePath} />
  </body>
</html>

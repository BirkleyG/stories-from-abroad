---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublishedShoots, parseDate } from "../../lib/publicPapers.js";

export async function getStaticPaths() {
  const shoots = await loadPublishedShoots();
  return shoots.map((shoot) => ({ params: { slug: shoot.token }, props: { shoot } }));
}

const { shoot } = Astro.props;
const base = import.meta.env.BASE_URL ?? "/";
const basePath = base.endsWith("/") ? base : `${base}/`;
const origin = Astro.site ? Astro.site.origin : "";
const pageUrl = origin ? new URL(Astro.url.pathname, Astro.site).href : "";
const AUTHOR = "Birkley Grunewald";

const photos = (Array.isArray(shoot.allPhotos) && shoot.allPhotos.length ? shoot.allPhotos : Array.isArray(shoot.photos) ? shoot.photos : [])
  .filter((photo) => photo && photo.url)
  .slice()
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const cover = (shoot.coverPhoto && shoot.coverPhoto.url ? shoot.coverPhoto : photos[0]) || null;
const intro = String(shoot.description || shoot.notes || shoot.subtitle || "").trim();
const place = shoot.locationLabel || [shoot.city, shoot.country].filter(Boolean).join(", ");
const description = (intro || `${shoot.title}: photographs by ${AUTHOR}${place ? ` in ${place}` : ""}.`).replace(/\s+/g, " ").slice(0, 300);
const isoDate = parseDate(shoot);
const tags = Array.isArray(shoot.tags) ? shoot.tags.filter(Boolean) : [];
const accent = /^#[0-9a-fA-F]{3,8}$/.test(shoot.accentColor || "") ? shoot.accentColor : "#8B7040";

const galleryLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: shoot.title,
  description,
  author: { "@type": "Person", name: AUTHOR },
  datePublished: isoDate || undefined,
  contentLocation: place || undefined,
  mainEntityOfPage: pageUrl || undefined,
  image: photos.slice(0, 20).map((photo) => ({
    "@type": "ImageObject",
    contentUrl: photo.url,
    name: photo.title || undefined,
    caption: photo.caption || photo.alt || undefined,
    creator: { "@type": "Person", name: AUTHOR },
  })),
};
---

<BaseLayout
  title={shoot.title}
  description={description}
  navMode="single"
  navLabel="Photography"
  showSubscribe={false}
  ogType="article"
  ogImage={cover ? cover.url : ""}
  extraJsonLd={[galleryLd]}
>
  <article class="shoot-page" style={`--shoot-accent:${accent}`}>
    <a class="shoot-back" href={`${basePath}photography/`}>&larr; All photography</a>
    <h1>{shoot.title}</h1>
    {shoot.subtitle && <p class="shoot-sub">{shoot.subtitle}</p>}
    <p class="shoot-meta">
      <span>{AUTHOR}</span>
      {place && <span> · {place}</span>}
      {isoDate && <span> · <time datetime={isoDate}>{isoDate}</time></span>}
      {shoot.cameraModel && <span> · {shoot.cameraModel}</span>}
    </p>
    {intro && <p class="shoot-intro">{intro}</p>}
    {tags.length > 0 && <p class="shoot-tags">{tags.join(" · ")}</p>}
    <div class="shoot-gallery">
      {photos.map((photo) => (
        <figure>
          <img
            src={photo.url}
            alt={photo.alt || photo.title || shoot.title}
            width={photo.width > 0 ? photo.width : undefined}
            height={photo.height > 0 ? photo.height : undefined}
            loading="lazy"
            decoding="async"
          />
          {(photo.caption || photo.title) && <figcaption>{photo.caption || photo.title}</figcaption>}
        </figure>
      ))}
    </div>
    <p class="shoot-links">
      <a href={`${basePath}photography/?shoot=${encodeURIComponent(shoot.token)}`}>Open the full photo story</a>
    </p>
  </article>

  <style>
    .shoot-page { max-width: 62rem; margin: 0 auto; padding: 4rem 1.25rem 6rem; }
    .shoot-back { font-family: var(--font-sc); letter-spacing: 0.14em; font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); text-decoration: none; }
    .shoot-back:hover { color: var(--shoot-accent); }
    .shoot-page h1 { font-family: var(--font-title); font-size: clamp(2.2rem, 6vw, 3.4rem); line-height: 1.1; margin: 0.6rem 0 0.6rem; font-weight: 500; }
    .shoot-sub { font-style: italic; font-size: 1.25rem; color: var(--text-mid); margin: 0 0 0.6rem; }
    .shoot-meta { color: var(--text-muted); font-size: 0.95rem; margin: 0 0 1.4rem; }
    .shoot-intro { max-width: 42rem; font-size: 1.18rem; line-height: 1.7; border-left: 2px solid var(--shoot-accent); padding-left: 1rem; margin: 0 0 1rem; }
    .shoot-tags { color: var(--text-muted); font-size: 0.9rem; margin: 0 0 2rem; }
    .shoot-gallery { display: grid; gap: 2.2rem; margin-top: 2rem; }
    .shoot-gallery figure { margin: 0; }
    .shoot-gallery img { width: 100%; height: auto; display: block; background: var(--bg-dark); }
    .shoot-gallery figcaption { margin-top: 0.6rem; font-size: 1rem; color: var(--text-mid); font-style: italic; }
    .shoot-links { margin-top: 2.4rem; }
    .shoot-links a { color: var(--shoot-accent); }
  </style>
</BaseLayout>

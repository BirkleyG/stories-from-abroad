---
import PhotographyPage from "../../components/PhotographyPage.astro";
import { loadPublishedShoots } from "../../lib/publicPapers.js";

export async function getStaticPaths() {
  const shoots = await loadPublishedShoots();
  return shoots.map((shoot) => ({ params: { slug: shoot.token }, props: { shoot } }));
}

const { shoot } = Astro.props;
---
<PhotographyPage shoot={shoot} />

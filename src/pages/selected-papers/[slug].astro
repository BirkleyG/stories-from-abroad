---
import SelectedPapersPage from "../../components/SelectedPapersPage.astro";
import { loadPublishedPapers } from "../../lib/publicPapers.js";

export async function getStaticPaths() {
  const papers = await loadPublishedPapers();
  return papers.map((paper) => ({ params: { slug: paper.token }, props: { paper } }));
}

const { paper } = Astro.props;
---
<SelectedPapersPage mode="public" paper={paper} />

---
import FacesPage from "../../components/FacesPage.astro";
import { loadPublishedFaces } from "../../lib/publicPapers.js";

export async function getStaticPaths() {
  const faces = await loadPublishedFaces();
  return faces.map((face) => ({ params: { slug: face.token }, props: { face } }));
}

const { face } = Astro.props;
---
<FacesPage face={face} />

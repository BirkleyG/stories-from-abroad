---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublishedFaces, parseDate } from "../../lib/publicPapers.js";

export async function getStaticPaths() {
  const faces = await loadPublishedFaces();
  return faces.map((face) => ({ params: { slug: face.token }, props: { face } }));
}

const { face } = Astro.props;
const base = import.meta.env.BASE_URL ?? "/";
const basePath = base.endsWith("/") ? base : `${base}/`;
const origin = Astro.site ? Astro.site.origin : "";
const pageUrl = origin ? new URL(Astro.url.pathname, Astro.site).href : "";
const AUTHOR = "Birkley Grunewald";

const isUrl = (value) => /^https?:\/\//.test(String(value || ""));
const portrait = [face.portraitUrl, face.heroUrl, face.pic].find(isUrl) || "";
const blocks = Array.isArray(face.article) ? face.article : [];
const photos = face.articlePhotos && typeof face.articlePhotos === "object" ? face.articlePhotos : {};
const place = [face.city, face.country].filter(Boolean).join(", ");
const title = face.storyTitle && face.storyTitle !== face.name ? `${face.name}: ${face.storyTitle}` : face.name;
const firstPara = (blocks.find((block) => block.type === "para") || {}).text || "";
const description = String(face.excerpt || face.descriptor || firstPara || `${face.name}, ${face.subtitle || "a portrait"} by ${AUTHOR}`).replace(/\s+/g, " ").slice(0, 300);
const isoDate = parseDate(face);
const facts = Array.isArray(face.facts) ? face.facts.filter(Boolean) : [];

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: portrait || undefined,
  author: { "@type": "Person", name: AUTHOR },
  datePublished: isoDate || undefined,
  mainEntityOfPage: pageUrl || undefined,
  about: {
    "@type": "Person",
    name: face.name,
    jobTitle: face.occupation || undefined,
    description: face.subtitle || face.descriptor || undefined,
    homeLocation: place || undefined,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  navMode="single"
  navLabel="Faces of the World"
  showSubscribe={false}
  ogType="article"
  ogImage={portrait}
  extraJsonLd={[articleLd]}
>
  <article class="face-page">
    <a class="face-back" href={`${basePath}faces-of-the-world/`}>&larr; Faces of the World</a>
    {place && <p class="face-loc">{place}{isoDate && <span> · <time datetime={isoDate}>{isoDate}</time></span>}</p>}
    <h1>{face.name}</h1>
    {(face.subtitle || face.descriptor) && <p class="face-sub">{face.subtitle || face.descriptor}</p>}
    {portrait && <img class="face-portrait" src={portrait} alt={face.portraitAlt || face.heroAlt || face.name} />}
    <dl class="face-dets">
      {face.age && <div><dt>Age</dt><dd>{face.age}</dd></div>}
      {face.religion && <div><dt>Faith</dt><dd>{face.religion}</dd></div>}
      {face.occupation && <div><dt>Work</dt><dd>{face.occupation}</dd></div>}
      {place && <div><dt>Location</dt><dd>{place}</dd></div>}
    </dl>
    {face.excerpt && <p class="face-excerpt">{face.excerpt}</p>}
    <div class="face-article">
      {blocks.map((block) => {
        if (block.type === "para") return <p>{block.text}</p>;
        if (block.type === "pull") return <blockquote>{block.text}</blockquote>;
        if (block.type === "qa") return <div class="qa"><p class="q">{block.q}</p><p>{block.a}</p></div>;
        if (block.type === "photo") {
          const media = photos[block.id];
          return media && media.url ? (
            <figure>
              <img src={media.url} alt={media.alt || face.name} loading="lazy" decoding="async" />
              {media.caption && <figcaption>{media.caption}</figcaption>}
            </figure>
          ) : null;
        }
        return null;
      })}
    </div>
    {facts.length > 0 && <p class="face-facts">{facts.join(" · ")}</p>}
    <p class="face-links">
      <a href={`${basePath}faces-of-the-world/#/profile/${encodeURIComponent(face.token)}`}>Open in the interactive map</a>
    </p>
  </article>

  <style>
    .face-page { max-width: 46rem; margin: 0 auto; padding: 4rem 1.25rem 6rem; }
    .face-back { font-family: var(--font-sc); letter-spacing: 0.14em; font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); text-decoration: none; }
    .face-back:hover { color: var(--gold); }
    .face-loc { color: var(--text-muted); margin: 1.2rem 0 0; font-size: 0.95rem; }
    .face-page h1 { font-family: var(--font-title); font-size: clamp(2.2rem, 6vw, 3.4rem); line-height: 1.1; margin: 0.3rem 0 0.6rem; font-weight: 500; }
    .face-sub { font-style: italic; font-size: 1.25rem; color: var(--text-mid); margin: 0 0 1.4rem; }
    .face-portrait { width: 100%; max-height: 38rem; object-fit: cover; display: block; margin-bottom: 1.4rem; }
    .face-dets { display: flex; flex-wrap: wrap; gap: 1.6rem; margin: 0 0 1.6rem; }
    .face-dets dt { font-family: var(--font-sc); letter-spacing: 0.14em; font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); }
    .face-dets dd { margin: 0; font-size: 1.1rem; }
    .face-excerpt { border-left: 2px solid var(--gold); padding-left: 1rem; font-style: italic; color: var(--text-mid); margin: 0 0 2rem; }
    .face-article p { font-size: 1.18rem; line-height: 1.75; margin: 0 0 1.2rem; }
    .face-article blockquote { font-family: var(--font-title); font-size: 1.5rem; line-height: 1.4; margin: 2rem 0; color: var(--green-light); }
    .face-article .qa .q { font-weight: 600; margin-bottom: 0.3rem; }
    .face-article figure { margin: 2rem 0; }
    .face-article img { width: 100%; height: auto; display: block; }
    .face-article figcaption { margin-top: 0.5rem; font-style: italic; color: var(--text-mid); }
    .face-facts { color: var(--text-muted); margin-top: 2rem; }
    .face-links a { color: var(--green-light); }
  </style>
</BaseLayout>

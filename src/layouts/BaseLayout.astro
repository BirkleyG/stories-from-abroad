---
import "../styles/global.css";
import { siteCopy } from "../content/siteCopy";

const copy = siteCopy.global;

const {
  title = copy.siteTitle,
  description = copy.defaultDescription,
  bodyClass = "",
  navMode = "home",
  navLabel = "",
  showSubscribe = true,
} = Astro.props;

const base = import.meta.env.BASE_URL ?? "/";
const basePath = base.endsWith("/") ? base : `${base}/`;
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const navItems = copy.nav.items.map((item) => {
  const path = item.path ? `${item.path}/` : "";
  return {
    label: item.label,
    href: `${basePath}${path}`,
    route: `/${path}`,
  };
});

const currentRoute = currentPath.startsWith(basePath)
  ? `/${currentPath.slice(basePath.length)}`.replace(/\/+/g, "/")
  : currentPath;

const pageTitle = title ? `${title} | ${copy.siteTitle}` : copy.siteTitle;
const publicFirebaseConfigJson = JSON.stringify({
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY ?? "",
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN ?? "",
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? "",
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID ?? "",
  functionsRegion: import.meta.env.PUBLIC_FIREBASE_FUNCTIONS_REGION ?? "us-central1",
});
const publicFirebaseApiKey = import.meta.env.PUBLIC_FIREBASE_API_KEY ?? "";

const AUTHOR_NAME = "Birkley Grunewald";
const siteOrigin = Astro.site ? Astro.site.origin : "";
const canonicalUrl = siteOrigin ? new URL(Astro.url.pathname, Astro.site).href : "";
const isPrivatePage = /\/(admin|subscriber-settings|unsubscribe|email-verified)\/?$/.test(Astro.url.pathname);
const isHome = currentRoute === "/";
const jsonLd = siteOrigin
  ? [
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: copy.siteTitle,
        url: `${siteOrigin}${basePath}`,
        description: copy.defaultDescription,
        author: { "@type": "Person", name: AUTHOR_NAME },
      },
      {
        "@context": "https://schema.org",
        "@type": "Person",
        name: AUTHOR_NAME,
        url: `${siteOrigin}${basePath}`,
        jobTitle: "Writer and Photographer",
        description: `${AUTHOR_NAME} is the writer and photographer behind ${copy.siteTitle}.`,
        mainEntityOfPage: `${siteOrigin}${basePath}read-the-story/`,
      },
    ]
  : [];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {isPrivatePage ? <meta name="robots" content="noindex, nofollow" /> : null}
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:site_name" content={copy.siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {!isPrivatePage && jsonLd.length ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Cormorant+SC:wght@300;400;500&family=Cormorant:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Lora:ital,wght@0,400;0,500;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <script is:inline data-firebase-api-key={publicFirebaseApiKey}>
      (() => {
        const uiKey = "sfa-subscriber-ui-v1";
        const apiKey = document.currentScript?.dataset?.firebaseApiKey || "";
        const authPrefix = "firebase:authUser:" + apiKey + ":";
        let hasSession = false;
        try {
          if (authPrefix !== "firebase:authUser::") {
            for (let i = 0; i < window.localStorage.length; i += 1) {
              const key = window.localStorage.key(i) || "";
              if (!key.startsWith(authPrefix)) continue;
              const value = window.localStorage.getItem(key);
              if (value && value !== "null") {
                hasSession = true;
                break;
              }
            }
          }
        } catch (error) {}
        let mode = "subscribe";
        try {
          const stored = window.localStorage.getItem(uiKey) === "profile" ? "profile" : "subscribe";
          const cached = JSON.parse(window.localStorage.getItem("sfa-subscriber-profile-v1") || "null");
          const profile = cached?.profile && typeof cached.profile === "object" ? cached.profile : cached;
          const tags = Array.isArray(profile?.segmentTags) ? profile.segmentTags : [];
          const prefs = Array.isArray(profile?.preferences) ? profile.preferences : [];
          const hasSoftProfile = profile?.status === "active" && (
            tags.length > 0 ||
            prefs.includes("all") ||
            prefs.includes("articles") ||
            prefs.includes("photography") ||
            prefs.includes("faces") ||
            prefs.includes("travel")
          );
          mode = hasSoftProfile || (hasSession && stored === "profile") ? "profile" : "subscribe";
        } catch (error) {}
        document.documentElement.setAttribute("data-sfa-ui", mode);
        const style = document.createElement("style");
        if (mode === "profile") {
          style.textContent = "[data-global-subscribe-control],[data-subscribe-control]{display:none !important;}[data-global-profile-control],[data-profile-control]{display:inline-flex !important;}";
        } else {
          style.textContent = "[data-global-profile-control],[data-profile-control]{display:none !important;}[data-global-subscribe-control]{display:inline-flex !important;}[data-subscribe-control]{display:initial !important;}";
        }
        document.head.appendChild(style);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <header class="site-nav" id="site-nav">
      {navMode === "single" ? (
        <>
          <a class="nav-back" href={basePath}>{copy.nav.backLabel}</a>
          <div class="nav-single-right">
            <span class="nav-single-label">{navLabel || copy.nav.items[0]?.label}</span>
            {showSubscribe ? (
              <>
                <button class="nav-cta" type="button" data-modal-open="subscribe" data-global-subscribe-control>{copy.nav.cta}</button>
                <a class="nav-profile-link" href={`${basePath}subscriber-settings/`} data-global-profile-control aria-label="Subscriber settings" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 20a8 8 0 0 1 16 0"></path>
                    <circle cx="12" cy="8" r="4.2"></circle>
                  </svg>
                </a>
              </>
            ) : null}
          </div>
        </>
      ) : (
        <>
          <a class="nav-wordmark" href={basePath}>{copy.nav.wordmark}</a>
          <nav>
            <ul class="nav-links">
              {navItems.map((item) => (
                <li>
                  <a href={item.href} class={currentRoute === item.route ? "active" : ""}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {showSubscribe ? (
            <>
              <button class="nav-cta" type="button" data-modal-open="subscribe" data-global-subscribe-control>{copy.nav.cta}</button>
              <a class="nav-profile-link" href={`${basePath}subscriber-settings/`} data-global-profile-control aria-label="Subscriber settings" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 20a8 8 0 0 1 16 0"></path>
                  <circle cx="12" cy="8" r="4.2"></circle>
                </svg>
              </a>
            </>
          ) : null}
          <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-panel" aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
        </>
      )}
    </header>

    {navMode === "single" ? null : (
      <div class="mobile-nav-panel" id="mobile-nav-panel">
        <ul>
          {navItems.map((item) => (
            <li>
              <a href={item.href} class={currentRoute === item.route ? "active" : ""}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        {showSubscribe ? (
          <>
            <button class="btn-ghost mobile-nav-subscribe" type="button" data-modal-open="subscribe" data-global-subscribe-control>{copy.nav.cta}</button>
            <a class="btn-ghost mobile-nav-subscribe" href={`${basePath}subscriber-settings/`} data-global-profile-control aria-label="Subscriber settings" hidden>Subscriber Settings</a>
          </>
        ) : null}
      </div>
    )}

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span class="footer-wordmark">{copy.footer.wordmark}</span>
      {navMode === "home" ? (
        <div class="footer-links">
          {copy.footer.homeLinks.map((link) => (
            <a href={`${basePath}${link.path ? `${link.path}/` : ""}`}>{link.label}</a>
          ))}
        </div>
      ) : null}
      <hr />
      <p class="footer-copy">{copy.footer.copyright}</p>
    </footer>

    <div class="modal-overlay" id="subscribe-modal" data-modal="subscribe">
      <div class="modal">
        <div class="modal-scroll">
          <button class="modal-close" type="button" data-modal-close><span aria-hidden="true">×</span>{copy.subscribeModal.closeLabel}</button>
          <div id="modal-form-view">
            <div class="modal-topline">
              <span></span>
              <strong>&amp;</strong>
              <span></span>
            </div>
            <h2 class="modal-title">
              <span>Subscribe to</span>
              <em>Dispatches</em>
            </h2>
            <p class="modal-sub">{copy.subscribeModal.subtitle}</p>
            <div class="form-group">
              <label class="form-label" for="sub-email">{copy.subscribeModal.emailLabel}</label>
              <input type="email" class="form-input" id="sub-email" placeholder={copy.subscribeModal.emailPlaceholder} />
            </div>
            <div class="form-group">
              <label class="form-label" for="sub-name">{copy.subscribeModal.nameLabel}</label>
              <input type="text" class="form-input" id="sub-name" placeholder={copy.subscribeModal.namePlaceholder} />
            </div>
            <span class="pref-label">{copy.subscribeModal.preferenceLabel}</span>
            <div class="checkboxes">
              <label class="checkbox-row">
                <input type="checkbox" id="pref-all" checked /> <span>{copy.subscribeModal.checkboxes[0]}</span>
              </label>
              <label class="checkbox-row">
                <input type="checkbox" id="pref-articles" /> <span>{copy.subscribeModal.checkboxes[1]}</span>
              </label>
              <label class="checkbox-row">
                <input type="checkbox" id="pref-photo" /> <span>{copy.subscribeModal.checkboxes[2]}</span>
              </label>
              <label class="checkbox-row">
                <input type="checkbox" id="pref-faces" /> <span>{copy.subscribeModal.checkboxes[3]}</span>
              </label>
              <label class="checkbox-row">
                <input type="checkbox" id="pref-travel" /> <span>{copy.subscribeModal.checkboxes[4]}</span>
              </label>
            </div>
            <button class="btn-ghost modal-submit" type="button" id="modal-submit">
              {copy.subscribeModal.submitLabel}
            </button>
            <p class="modal-status" id="modal-status" aria-live="polite"></p>
          </div>
          <div class="modal-success" id="modal-success-view">
            <div class="modal-check">{copy.subscribeModal.success.title}</div>
            <h3 id="modal-success-title">{copy.subscribeModal.success.subtitle}</h3>
            <p id="modal-success-body">{copy.subscribeModal.success.body}</p>
            <a id="modal-success-settings" class="btn-ghost modal-submit" href={`${basePath}subscriber-settings/`} style="display:none; margin-top:1rem;">
              Subscriber Settings
            </a>
          </div>
        </div>
      </div>
    </div>

    <script id="public-firebase-config" type="application/json" set:html={publicFirebaseConfigJson}></script>
    <script>
      import {
        SUBSCRIBER_SEGMENTS,
        cacheSubscriberProfile,
        completeSubscriberSignInFromLink,
        getSubscriberRecord,
        normalizeEmail,
        normalizeSubscriberSegments,
        onSubscriberAuthChange,
        readCachedSubscriberProfile,
        sendSubscriberSignInLink,
        subscriberHasAnySegment,
        upsertSubscriberRecord,
      } from "../lib/subscriberClient";
      import { firebaseReady } from "../lib/firebaseClient";

      const nav = document.getElementById("site-nav");
      if (nav) {
        const onScroll = () => {
          nav.classList.toggle("scrolled", window.scrollY > 30);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }

      const navToggle = document.getElementById("nav-toggle");
      const mobileNavPanel = document.getElementById("mobile-nav-panel");
      if (navToggle && mobileNavPanel) {
        const setNavOpen = (open) => {
          navToggle.classList.toggle("open", open);
          navToggle.setAttribute("aria-expanded", String(open));
          mobileNavPanel.classList.toggle("open", open);
          document.body.classList.toggle("mobile-nav-open", open);
        };
        navToggle.addEventListener("click", () => {
          setNavOpen(!mobileNavPanel.classList.contains("open"));
        });
        mobileNavPanel.querySelectorAll("a, button").forEach((el) => {
          el.addEventListener("click", () => setNavOpen(false));
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setNavOpen(false);
        });
        window.addEventListener("resize", () => {
          if (window.innerWidth > 900) setNavOpen(false);
        });
      }

      const modal = document.getElementById("subscribe-modal");
      const modalSubmit = document.getElementById("modal-submit");
      const formView = document.getElementById("modal-form-view");
      const successView = document.getElementById("modal-success-view");
      const statusEl = document.getElementById("modal-status");
      const emailInput = document.getElementById("sub-email");
      const nameInput = document.getElementById("sub-name");
      const successTitle = document.getElementById("modal-success-title");
      const successBody = document.getElementById("modal-success-body");
      const successSettingsLink = document.getElementById("modal-success-settings");
      const prefAll = document.getElementById("pref-all");
      const prefArticles = document.getElementById("pref-articles");
      const prefPhoto = document.getElementById("pref-photo");
      const prefFaces = document.getElementById("pref-faces");
      const prefTravel = document.getElementById("pref-travel");
      const segmentToPreference = {
        "Articles & Op-Eds": "articles",
        Photography: "photography",
        "Faces of the World": "faces",
        Travel: "travel",
      };

      let authUser = null;
      let subscriberProfile = null;

      function updateGlobalSubscribeControls(profile) {
        const subscribed = subscriberHasAnySegment(profile);
        const mode = subscribed ? "profile" : "subscribe";
        document.documentElement.setAttribute("data-sfa-ui", mode);
        try {
          window.localStorage.setItem("sfa-subscriber-ui-v1", mode);
        } catch (error) {}
        document.querySelectorAll("[data-global-subscribe-control]").forEach((el) => {
          el.hidden = subscribed;
          if (el instanceof HTMLElement) {
            if (subscribed) {
              el.style.setProperty("display", "none", "important");
            } else {
              el.style.setProperty("display", "inline-flex", "important");
            }
          }
        });
        document.querySelectorAll("[data-global-profile-control]").forEach((el) => {
          el.hidden = !subscribed;
          if (el instanceof HTMLElement) {
            if (subscribed) {
              el.style.setProperty("display", "inline-flex", "important");
            } else {
              el.style.setProperty("display", "none", "important");
            }
          }
          if (subscribed && el instanceof HTMLAnchorElement) {
            el.href = settingsHrefWithReturn(el.getAttribute("href") || el.href, profile?.email || subscriberProfile?.email || "");
          }
        });
        if (successSettingsLink instanceof HTMLAnchorElement) {
          successSettingsLink.href = settingsHrefWithReturn(successSettingsLink.getAttribute("href") || successSettingsLink.href, profile?.email || subscriberProfile?.email || "");
        }
      }

      function normalizeString(value) {
        return String(value ?? "").trim();
      }

      function unique(items) {
        return Array.from(new Set(items.filter(Boolean)));
      }

      function collectPreferences() {
        const out = [];
        if (prefAll?.checked) out.push("all");
        if (prefArticles?.checked) out.push("articles");
        if (prefPhoto?.checked) out.push("photography");
        if (prefFaces?.checked) out.push("faces");
        if (prefTravel?.checked) out.push("travel");
        return out;
      }

      function segmentsFromPreferences(preferences) {
        const list = Array.isArray(preferences) ? preferences.map(normalizeString) : [];
        if (list.includes("all")) return [...SUBSCRIBER_SEGMENTS];
        return unique(list.map((item) => {
          if (item === "articles" || item === "papers") return "Articles & Op-Eds";
          if (item === "photography" || item === "photo") return "Photography";
          if (item === "faces" || item === "stories") return "Faces of the World";
          if (item === "travel") return "Travel";
          return "";
        }));
      }

      function segmentsFromProfile(profile) {
        return normalizeSubscriberSegments(profile);
      }

      function segmentsFromPath(pathname) {
        const path = normalizeString(pathname).toLowerCase();
        if (path.includes("selected-papers")) return ["Articles & Op-Eds"];
        if (path.includes("photography")) return ["Photography"];
        if (path.includes("faces-of-the-world")) return ["Faces of the World"];
        if (path.includes("travel-stories")) return ["Travel"];
        return [];
      }

      function preferencesFromSegments(segments) {
        return unique(segments.map((segment) => segmentToPreference[segment]));
      }

      function currentReturnPath() {
        if (typeof window === "undefined") return "/";
        return `${window.location.pathname}${window.location.search}${window.location.hash}`;
      }

      function settingsHrefWithReturn(rawHref, email = "") {
        if (typeof window === "undefined") return rawHref;
        try {
          const url = new URL(rawHref || "/subscriber-settings/", window.location.origin);
          url.searchParams.set("from", currentReturnPath());
          const normalized = normalizeEmail(email || "");
          if (normalized) url.searchParams.set("email", normalized);
          return `${url.pathname}${url.search}${url.hash}`;
        } catch (error) {
          return rawHref;
        }
      }

      function mergeSubscriberProfile(baseProfile, fallback) {
        const profile = baseProfile && typeof baseProfile === "object" ? baseProfile : {};
        const baseSegments = segmentsFromProfile(profile);
        const fallbackSegments = Array.isArray(fallback?.segmentTags) ? fallback.segmentTags : [];
        const segmentTags = unique([...baseSegments, ...fallbackSegments]);
        return {
          ...profile,
          email: normalizeEmail(profile.email || fallback?.email || ""),
          name: normalizeString(profile.name || fallback?.name || "").slice(0, 80),
          status: normalizeString(profile.status || fallback?.status || "active"),
          preferences: Array.isArray(profile.preferences) && profile.preferences.length
            ? profile.preferences
            : (Array.isArray(fallback?.preferences) && fallback.preferences.length ? fallback.preferences : preferencesFromSegments(segmentTags)),
          segmentTags,
        };
      }

      function defaultSegmentsForCurrentPage() {
        return typeof window === "undefined" ? [] : segmentsFromPath(window.location.pathname);
      }

      function sourceForCurrentPage() {
        if (typeof window === "undefined") return "global_modal";
        const segments = defaultSegmentsForCurrentPage();
        if (segments.includes("Articles & Op-Eds")) return "articles_modal";
        if (segments.includes("Photography")) return "photography_modal";
        if (segments.includes("Faces of the World")) return "faces_modal";
        if (segments.includes("Travel")) return "travel_modal";
        return "global_modal";
      }

      function collectSegmentTags(preferences) {
        const selected = segmentsFromPreferences(preferences);
        if (selected.length) return selected;
        const pageSegments = defaultSegmentsForCurrentPage();
        return pageSegments.length ? pageSegments : [...SUBSCRIBER_SEGMENTS];
      }

      function profileHasSegments(profile, segments) {
        if (!profile || profile.status !== "active") return false;
        const existing = segmentsFromProfile(profile);
        return segments.every((segment) => existing.includes(segment));
      }

      function syncPreferenceControls() {
        const lock = Boolean(prefAll?.checked);
        [prefArticles, prefPhoto, prefFaces, prefTravel].forEach((el) => {
          if (!el) return;
          el.disabled = lock;
          if (lock) el.checked = false;
        });
      }

      function applyDefaultPreferencesForPage() {
        const pageSegments = defaultSegmentsForCurrentPage();
        if (!prefAll) return;
        if (!pageSegments.length) {
          prefAll.checked = true;
          [prefArticles, prefPhoto, prefFaces, prefTravel].forEach((el) => {
            if (el) el.checked = false;
          });
          syncPreferenceControls();
          return;
        }
        prefAll.checked = false;
        if (prefArticles) prefArticles.checked = pageSegments.includes("Articles & Op-Eds");
        if (prefPhoto) prefPhoto.checked = pageSegments.includes("Photography");
        if (prefFaces) prefFaces.checked = pageSegments.includes("Faces of the World");
        if (prefTravel) prefTravel.checked = pageSegments.includes("Travel");
        syncPreferenceControls();
      }

      function flagsFromPreferences(preferences) {
        const set = new Set(Array.isArray(preferences) ? preferences : []);
        const segments = collectSegmentTags(preferences);
        const segmentSet = new Set(segments);
        return {
          wantsAllUpdates: set.has("all") || segments.length === SUBSCRIBER_SEGMENTS.length,
          wantsPapers: set.has("articles") || set.has("papers") || segmentSet.has("Articles & Op-Eds"),
          wantsPhotography: set.has("photography") || segmentSet.has("Photography"),
          wantsFaces: set.has("faces") || set.has("stories") || segmentSet.has("Faces of the World"),
          wantsTravel: set.has("travel") || segmentSet.has("Travel"),
        };
      }

      function setStatus(message, tone = "muted") {
        if (!statusEl) return;
        statusEl.textContent = message;
        if (tone === "error") {
          statusEl.style.color = "var(--red)";
        } else if (tone === "ok") {
          statusEl.style.color = "var(--green)";
        } else {
          statusEl.style.color = "var(--text-muted)";
        }
      }

      function showSuccess(title, body) {
        if (successTitle) successTitle.textContent = title;
        if (successBody) successBody.textContent = body;
        if (successSettingsLink instanceof HTMLElement) {
          successSettingsLink.style.display = "none";
        }
        if (formView && successView) {
          formView.style.display = "none";
          successView.style.display = "block";
        }
      }

      function openModal() {
        if (!modal) return;
        applyDefaultPreferencesForPage();
        modal.classList.add("open");
        document.body.style.overflow = "hidden";
        setStatus("");
        if (emailInput) emailInput.classList.remove("input-error");
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove("open");
        document.body.style.overflow = "";
        if (formView && successView) {
          formView.style.display = "";
          successView.style.display = "none";
        }
        setStatus("");
      }

      document.querySelectorAll("[data-modal-open='subscribe']").forEach((btn) => {
        btn.addEventListener("click", openModal);
      });

      if (modal) {
        modal.addEventListener("click", (event) => {
          if (event.target === modal) closeModal();
        });
      }

      document.querySelectorAll("[data-modal-close]").forEach((btn) => {
        btn.addEventListener("click", closeModal);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeModal();
      });

      if (prefAll) {
        prefAll.addEventListener("change", () => {
          syncPreferenceControls();
        });
      }

      syncPreferenceControls();

      [prefArticles, prefPhoto, prefFaces, prefTravel].forEach((el) => {
        if (!el) return;
        el.addEventListener("change", () => {
          if (!prefAll) return;
          if (el.checked) prefAll.checked = false;
          syncPreferenceControls();
        });
      });

      const cached = readCachedSubscriberProfile();
      if (cached?.profile) {
        subscriberProfile = cached.profile;
        updateGlobalSubscribeControls(subscriberProfile);
        if (cached.email && emailInput instanceof HTMLInputElement && !emailInput.value) emailInput.value = cached.email;
        if (cached.profile.name && nameInput instanceof HTMLInputElement && !nameInput.value) nameInput.value = cached.profile.name;
      } else {
        updateGlobalSubscribeControls(null);
      }

      completeSubscriberSignInFromLink()
        .then(async ({ completed, user }) => {
          if (!completed || !user?.uid) return;
          const profile = await getSubscriberRecord(user.uid);
          authUser = user;
          subscriberProfile = profile;
          cacheSubscriberProfile({ user, profile });
          updateGlobalSubscribeControls(profile);
          const title = profile?.name ? "Subscription received" : "Subscription confirmed";
          showSuccess(title, "Your subscriber account is active and ready for comments.");
        })
        .catch(() => {});

      onSubscriberAuthChange(async (user) => {
        authUser = user;
        if (!user?.uid) {
          const cachedProfile = readCachedSubscriberProfile()?.profile || null;
          subscriberProfile = cachedProfile;
          updateGlobalSubscribeControls(cachedProfile);
          return;
        }
        const profile = await getSubscriberRecord(user.uid);
        subscriberProfile = profile;
        cacheSubscriberProfile({ user, profile });
        updateGlobalSubscribeControls(profile);
        const preferredName = profile?.name || "";
        if (preferredName && nameInput instanceof HTMLInputElement && !nameInput.value.trim()) nameInput.value = preferredName;
      }).catch(() => undefined);

      if (modalSubmit) {
        modalSubmit.addEventListener("click", async () => {
          if (!(emailInput instanceof HTMLInputElement)) return;
          const normalizedEmail = normalizeEmail(emailInput.value);
          if (!normalizedEmail.includes("@")) {
            emailInput.focus();
            emailInput.classList.add("input-error");
            setStatus("Please enter a valid email.", "error");
            return;
          }

          emailInput.classList.remove("input-error");
          setStatus("");

          if (!firebaseReady) {
            setStatus("Subscriber services are not configured yet.", "error");
            return;
          }

          const name = nameInput instanceof HTMLInputElement ? nameInput.value : "";
          const preferences = collectPreferences();
          const segmentTags = collectSegmentTags(preferences);
          const source = sourceForCurrentPage();

          if (modalSubmit instanceof HTMLButtonElement) {
            modalSubmit.disabled = true;
          }

          try {
            if (authUser?.uid && profileHasSegments(subscriberProfile, segmentTags)) {
              showSuccess("You are already following the journey!", "Use Subscriber Settings to manage your preferences.");
              return;
            }

            if (authUser?.uid && normalizeEmail(authUser.email) === normalizedEmail) {
              subscriberProfile = await upsertSubscriberRecord(authUser, {
                name,
                preferences,
                segmentTags,
                source,
              });
              cacheSubscriberProfile({ user: authUser, profile: subscriberProfile });
              updateGlobalSubscribeControls(subscriberProfile);
              showSuccess("Subscription confirmed", "Your subscriber account is active.");
              return;
            }

            const result = await sendSubscriberSignInLink({
              email: normalizedEmail,
              name,
              preferences,
              segmentTags,
              source,
              redirectUrl: window.location.href,
            });

            if (!result.ok) {
              setStatus("Could not send the confirmation link. Please retry.", "error");
              return;
            }

            if (result.existing) {
              const profile = mergeSubscriberProfile(result.profile, {
                email: normalizedEmail,
                name: normalizeString(name).slice(0, 80),
                status: "active",
                preferences,
                segmentTags,
              });
              subscriberProfile = profile;
              cacheSubscriberProfile({ email: normalizedEmail, profile });
              updateGlobalSubscribeControls(profile);
              showSuccess("You are already following the journey!", result.updated
                ? "Your subscription has been updated successfully."
                : "Use Subscriber Settings to manage your preferences.");
              if (successSettingsLink instanceof HTMLElement) {
                successSettingsLink.style.display = "inline-block";
              }
              return;
            }

            showSuccess("Check your inbox", "Use the sign-in link to confirm your subscription.");
          } catch (error) {
            setStatus("Subscription failed. Please retry in a moment.", "error");
          } finally {
            if (modalSubmit instanceof HTMLButtonElement) {
              modalSubmit.disabled = false;
            }
          }
        });
      }
    </script>
  </body>
</html>
